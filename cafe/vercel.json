{
  "buildCommand": "CI=true npm run build",
  "outputDirectory": "build",
  "git": {
    "deploymentEnabled": {
      "prd": true,
      "dev": false
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
