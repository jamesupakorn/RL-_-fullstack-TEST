{
  "buildCommand": "CI=true npm run build",
  "outputDirectory": "build",
  "env": {
    "REACT_APP_API_MODE": "@react_app_api_mode",
    "REACT_APP_API_URL_LOCAL": "@react_app_api_url_local",
    "REACT_APP_API_URL_PROD": "@react_app_api_url_prod"
  },
  "git": {
    "deploymentEnabled": {
      "prd": true,
      "dev": false
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
